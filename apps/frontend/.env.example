# Deliberately relative, not an absolute origin — every browser-facing API
# call in this app is a simple string-concat/template-literal prefix (never
# `new URL(...)`), so a relative value resolves against whatever host the
# browser actually used to load the page. An earlier version of this
# pointed at a hardcoded "https://localhost:4430/api": that worked from
# literally "localhost" and broke for everyone else — a LAN IP, 127.0.0.1,
# a real domain later — either as a straight connection failure (a
# different device's "localhost" means that device, not this server) or a
# CORS rejection (the gateway's allowedOrigins, driven by NGINX_URL, only
# ever matches one literal origin). Since nginx serves the frontend and
# /api from the same origin, a relative path makes almost every browser
# call same-origin and sidesteps the whole problem.
NEXT_PUBLIC_URL="/api"
INTERNAL_API_URL="http://api-gateway:8080"
